# COMPRASAL Credentials
COMPRASAL_EMAIL=tu_email@empresa.com
COMPRASAL_PASSWORD=tu_password

# TOTP automático (opcional — dejar vacío para ingresar OTP manualmente)
COMPRASAL_TOTP_SECRET=

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-...

# Email / SMTP (credenciales compartidas para todos los clientes)
# El destinatario de cada cliente se configura en clients/{cliente}.yaml
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail
NOTIFICATION_FROM=tender-opportunity-tracker <tu_email@gmail.com>

# ── MODO VALIDACIÓN — redirección de correo ───────────────────────────────
# Si tiene valor, TODO el correo (reportes Y alertas) se redirige aquí y se
# IGNORAN los destinatarios de clients/*.yaml. Sirve para validar en un tenant
# de prueba sin escribirle a los clientes reales.
# Acepta varias direcciones separadas por coma. Vacío = comportamiento normal.
# El asunto se prefija con [VALIDACIÓN] y se agrega la cabecera X-Original-To.
NOTIFICATION_OVERRIDE_TO=


# Schedule (hora local El Salvador UTC-6)
SCHEDULE_MORNING=07:00
SCHEDULE_AFTERNOON=14:00

# Branding (white-label — cambiar por deployment)
APP_NAME=AMALIA
APP_FULL_NAME=AMALIA

# Bot Config
HEADLESS=true
LOG_LEVEL=INFO
DAYS_LOOKBACK=1

# Chromium path (solo para ARM/OCI — dejar vacío en desarrollo local)
# CHROMIUM_PATH=/usr/bin/chromium

# ── Fase 2 · Drill-down de pliegos (MVP Track A) ──────────────────────────
# Feature flag maestro. En false el sistema se comporta como v0.1.0 (solo metadatos).
ENABLE_DRILLDOWN=false
# Modelos runtime de Claude para el drill-down (IDs configurables).
# Análisis: Sonnet 5 por default; A/B contra claude-opus-4-8 durante la validación.
MODEL_TRIAGE=claude-haiku-4-5
MODEL_ANALYSIS=claude-sonnet-5
# Guardias del PDF (límites de la API de Claude: 32 MB / 100 páginas)
PLIEGO_MAX_MB=32
PLIEGO_MAX_PAGES=100
# Páginas iniciales enviadas al triaje (solo texto, barato)
TRIAGE_PAGES=15
# Paginas rasterizadas enviadas al triaje de pliegos ESCANEADOS.
# Regula el costo: cada pagina-imagen cuesta ~1.500-2.000 tokens.
TRIAGE_RASTER_PAGES=5
# Presupuesto diario de tokens (guardia de cuota pre-flight)
DAILY_TOKEN_BUDGET=2000000
# Directorio temporal de PDFs descargados (se borran tras analizar)
DRILLDOWN_TMP_DIR=/tmp/amalia_pliegos

# ── Fase 2 · Track B — Memoria institucional (Oracle ADB 23ai) ────────────
# Flag independiente: en false, Track B es no-op (sistema == Track A).
ENABLE_MEMORIA=false
ADB_USER=AMALIA
ADB_PASSWORD=
# DSN del alias del wallet (ej: amaliadb_high)
ADB_DSN=
# OCID del secret de Vault que contiene el wallet mTLS (zip)
ADB_WALLET_SECRET_OCID=
# tmpfs: el wallet vive en RAM, nunca en disco persistente
ADB_WALLET_DIR=/dev/shm/amalia_wallet
ADB_WALLET_PASSWORD=
# Modelo ONNX cargado DENTRO de la BD (embeddings in-database, 384 dims)
EMBEDDING_MODEL_NAME=MINILM_L6
RAG_TOP_K=5
CHUNK_TOKENS=800
CHUNK_OVERLAP=100
PRECEDENTES_MAX=3
# Bucket de Object Storage (handoff entre etapas / data-lake). Vacío = disco local.
OBJSTORE_BUCKET=
