# Environment
.env

# Generated data (runtime artifacts — should not be versioned)
data/storage_state.json
data/last_run.json
data/screenshots/
data/debug/
data/history/
data/export/
data/*.log
# Conteo de fallos del keepalive de la ADB: estado de una VM concreta, no del repo.
data/adb_keepalive.json

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/

# OCI deployment state (per-tenant OCIDs, generated at deploy time)
oci/state/*
!oci/state/.gitkeep

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
data/medicion_pliegos.json
data/diag*.json

# Respaldos operativos descargados de una VM (rsync). Son datos de producción
# —historial, sesiones, capturas—, no código: pesan decenas de MB y no deben
# entrar al repositorio.
data_*_backup/
