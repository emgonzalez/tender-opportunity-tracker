FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/El_Salvador
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium

RUN ln -sf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# System Chromium (ARM64-compatible) + dependencias de rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash botuser
WORKDIR /app

# Solo pyproject.toml, sin src/: con `packages.find` sin coincidencias setuptools
# construye una distribución vacía, así que `pip install .` instala exactamente
# las dependencias declaradas. Mantiene la capa de dependencias cacheada entre
# cambios de código.
COPY pyproject.toml .
RUN pip install --no-cache-dir .

COPY src/ src/
COPY templates/ templates/
COPY clients/ clients/

RUN mkdir -p data/screenshots data/debug data/history \
    && chown -R botuser:botuser /app

USER botuser
CMD ["python", "-m", "src.main"]
