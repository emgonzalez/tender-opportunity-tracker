FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/El_Salvador
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium

RUN ln -sf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# System Chromium (ARM64-compatible) + dependencias de rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash botuser
WORKDIR /app

# Solo pyproject.toml, sin src/: con `packages.find` sin coincidencias setuptools
# construye una distribución vacía, así que `pip install .` instala exactamente
# las dependencias declaradas. Mantiene la capa de dependencias cacheada entre
# cambios de código.
COPY pyproject.toml .
# Apagado por default: la imagen que va a producción NO lleva el SDK de OCI.
# Los dos costos, medidos: `import oci` suma +39-42 MB de RSS, y el SDK ocupa
# 468 MB en site-packages —los clientes generados de todos los servicios de OCI,
# para usar un solo endpoint de inferencia, más cryptography, pyOpenSSL y
# aiohttp; en la imagen x86 eso se tradujo en +405 MB—. Hoy los cuatro tenants
# corren con LLM_PROVIDER=anthropic: se construye con --build-arg INSTALL_OCI=1
# solo para el tenant de dev, mientras se valida el proveedor alternativo.
#
# Ojo en esta variante: a diferencia de la x86, acá el build corre EN la VM ARM
# —docker-compose.oci.yml conserva su `build:`—, así que encender el flag suma
# esos cientos de MB de descarga e instalación al momento de mayor presión del
# despliegue, en la máquina que menos margen tiene.
#
# El ARG va ACÁ, junto a la capa que modifica: participa de la clave de caché de
# este RUN, así que las dos variantes conviven sin pisarse.
ARG INSTALL_OCI=0
RUN if [ "$INSTALL_OCI" = "1" ]; then pip install --no-cache-dir ".[oci]"; \
    else pip install --no-cache-dir . ; fi

# SHA del commit que se está construyendo (lo pasa CI con --build-arg). Va
# después de las capas de dependencias: cambia en cada commit y ponerlo antes
# invalidaría su caché.
ARG GIT_SHA=dev
ENV APP_VERSION=$GIT_SHA

COPY src/ src/
COPY templates/ templates/
COPY clients/ clients/

RUN mkdir -p data/screenshots data/debug data/history \
    && chown -R botuser:botuser /app

USER botuser
CMD ["python", "-m", "src.main"]
