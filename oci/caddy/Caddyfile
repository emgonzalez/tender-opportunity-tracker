# Caddy delante del servicio web (ADR 0005). Termina TLS —certificado de Let's
# Encrypt, obtenido y renovado solo— y reenvía a `web:8080` dentro de la red de
# compose. WEB_HOSTNAME lo escribe oci/lib/04-app.sh en el .env de la VM.
#
# Se reenvía lo que el servicio expone: los enlaces del correo (/f/…), la sonda
# (/healthz) y el portal con su acceso (/acceso, /salir, /portal…), que desde la
# Fase 3 del plan de identidad exige sesión. El portal está detrás de DOS llaves:
# esta lista y `ENABLE_PORTAL` en la VM. Con el flag apagado (por defecto) el
# servicio responde 404 a esas rutas, igual que a cualquier otra. Todo lo demás se
# corta acá. Para publicar algo nuevo hay que tocar este archivo a propósito.
{$WEB_HOSTNAME} {
	# Compresión (E13): la vista de país pesa ~365 KB de HTML con datos reales (casi todo texto repetido,
	# comprime ~10×). BREACH —comprimir una respuesta que mezcla un secreto (el token CSRF) con texto
	# reflejado— exige provocar cargas AUTENTICADAS repetidas desde otro sitio; la cookie de sesión es
	# `SameSite=Lax` y el navegador no la manda en esas peticiones, así que el riesgo no aplica a este servicio.
	encode zstd gzip

	@expuesto path /f/* /healthz /acceso /acceso/* /salir /login /login/* /logout /portal /portal/*
	handle @expuesto {
		reverse_proxy web:8080
	}
	handle {
		respond 404
	}
}
