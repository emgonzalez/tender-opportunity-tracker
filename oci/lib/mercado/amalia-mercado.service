[Unit]
# Corrida semanal de src.mercado (participados + resolver de COMPRASAL y, con
# features.enable_mercado_sicop, el paso de SICOP al final). Ver
# oci/lib/mercado/amalia-mercado.sh. La instala oci/lib/09-mercado.sh solo con
# features.enable_mercado_cron: true.
Description=AMALIA — mercado semanal: participados + resolver (cliente __CLIENTE__) + SICOP opcional
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=amalia-failure.service
# Sin Conflicts=amalia.service a propósito: es simétrico, y arrancar esta unit
# mataría una corrida diaria en curso. La exclusión mutua la hace el script
# (espera a que la otra termine). Sin Restart=: el fallo esperado es la sesión
# de COMPRASAL vencida, y reintentar no la renueva; el próximo domingo es el
# reintento.

[Service]
Type=oneshot
WorkingDirectory=/opt/tender-opportunity-tracker
User=ubuntu
Group=ubuntu
Environment=AMALIA_COMPOSE_FILE=__COMPOSE__
Environment=AMALIA_MERCADO_CLIENTE=__CLIENTE__
ExecStart=/opt/tender-opportunity-tracker/oci/lib/mercado/amalia-mercado.sh
# Peor caso, con los topes del script: 30 min de espera por otra corrida
# (WAIT_MAX_S) + 3 pasos × 90 min (STEP_TIMEOUT_S: participados, resolver y
# SICOP) + 5 min del correo de fallo (notify) = 305 min. Con margen: 5h30min.
# Antes eran 4h para dos pasos; con el de SICOP, 4h podía matar la unit desde
# systemd ANTES de que el `timeout` del script cortara el paso y avisara con su
# mensaje. Lo esperado es mucho menos: SICOP sin el mercado en firme son minutos,
# y con él ~30 min (~250 páginas a ~7 s).
TimeoutStartSec=5h30min
